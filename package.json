{
  "name": "@starterkit/monorepo",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "sync:shared": "node scripts/sync-shared.mjs",
    "sync:shared:check": "node scripts/sync-shared.mjs --check",
    "check:shadows": "node scripts/check-dashboard-shadows.mjs",
    "lint": "pnpm --recursive run lint",
    "type-check": "pnpm --recursive run type-check",
    "test": "pnpm --recursive run test",
    "build": "pnpm --recursive run build",
    "format": "pnpm --recursive run format",
    "format:check": "pnpm --recursive run format:check",
    "test:e2e": "pnpm --recursive run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4"
  }
}
