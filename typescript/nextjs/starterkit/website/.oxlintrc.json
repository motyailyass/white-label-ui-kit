{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@hugeicons/**"],
            "message": "Use <Icon name=\"…\" /> from @/components/icons. Only src/components/icons may import Hugeicons."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/icons/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
